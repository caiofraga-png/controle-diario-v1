rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUserDocument(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userRecord(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function approvedUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRecord(request.auth.uid).data.status == "approved";
    }

    function activeAdmin() {
      return approvedUser()
        && userRecord(request.auth.uid).data.role == "admin";
    }

    function allowedCorporateDomain() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/settings/allowedDomains)
        && get(/databases/$(database)/documents/settings/allowedDomains).data.domains
          .has(request.auth.token.email.split("@")[1].lower());
    }

    // Profile documents are provisioned/maintained by a trusted admin process.
    // A client cannot approve itself, alter its organizational fields, or grant roles.
    match /users/{uid} {
      allow read: if ownUserDocument(uid) || activeAdmin();
      allow create, update, delete: if activeAdmin();

      // Administrators may read operational records for oversight, but cannot
      // create/update/delete operational data belonging to another user.
      match /operational/{document=**} {
        allow read: if approvedUser()
          && (request.auth.uid == uid || activeAdmin());
        allow create, update, delete: if approvedUser()
          && request.auth.uid == uid;
      }

      match /configuration/{document=**} {
        allow read, write: if approvedUser() && request.auth.uid == uid;
      }

      match /calendar/{document=**} {
        allow read, write: if approvedUser() && request.auth.uid == uid;
      }

      match /usefulLinks/{document=**} {
        allow read, write: if approvedUser() && request.auth.uid == uid;
      }
    }

    // Requests are separate from user profiles and never grant access themselves.
    match /accessRequests/{uid} {
      allow create: if ownUserDocument(uid)
        && allowedCorporateDomain()
        && request.resource.data.keys().hasOnly(["uid", "email", "status", "requestedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending";
      allow read: if ownUserDocument(uid) || activeAdmin();
      allow update, delete: if activeAdmin();
    }

    match /organizationSectors/{sectorId} {
      allow read: if approvedUser();
      allow write: if activeAdmin();
    }

    match /organizationContacts/{contactId} {
      allow read: if approvedUser();
      allow write: if activeAdmin();
    }

    // The domain allow-list is not secret and must be readable before approval
    // so a first-time visitor can determine whether they may request access.
    match /settings/allowedDomains {
      allow read: if signedIn();
      allow write: if activeAdmin();
    }

    match /settings/{settingId} {
      allow read: if approvedUser();
      allow write: if activeAdmin();
    }

    match /adminAudit/{auditId} {
      allow read: if activeAdmin();
      allow create: if activeAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Deny all unspecified collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
