# Firebase Web app configuration (public client settings, not admin credentials).
# Copy to your local environment as .env.local or configure equivalent VITE_* values
# in the build environment. Do not commit real deployment-specific values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
