{
  "name": "controle-diario-web",
  "version": "1.0.0",
  "private": true,
  "description": "Leste - Controle Diário — aplicação web",
  "author": "Caio Fraga",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:ui": "vitest run",
    "test:rules": "node --test tests/firestore.rules.test.cjs",
    "test:backup": "node --experimental-strip-types --test tests/backup-crypto.test.cjs tests/backup-restore.test.cjs",
    "test:backup:firestore": "node --experimental-strip-types --test tests/backup-restore-firestore.test.cjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "exceljs": "^4.4.0",
    "docx": "9.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^14.12.1"
  }
}